<resources>
    <style name="Arena" />
    <color name="lavender">#B4C5FF</color>
    <style name="Arena.Title">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/space_grotesk</item><item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">24sp</item><item name="android:textStyle">bold</item><item name="android:layout_marginBottom">8dp</item>
    </style>
    <style name="Arena.Label">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/space_grotesk</item><item name="android:textColor">@color/cyan</item>
        <item name="android:textSize">11sp</item><item name="android:letterSpacing">0.08</item><item name="android:textStyle">bold</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>
    <style name="Arena.Body">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item><item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item><item name="android:lineSpacingExtra">3dp</item><item name="android:layout_marginBottom">12dp</item>
    </style>
    <style name="Arena.Input" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">12dp</item><item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item><item name="boxCornerRadiusBottomStart">12dp</item><item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxBackgroundColor">@color/surface_low</item><item name="boxStrokeColor">@color/blue</item>
    </style>
    <style name="Arena.Edit">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item><item name="android:textSize">14sp</item><item name="android:singleLine">true</item>
        <item name="android:textColor">@color/text_primary</item><item name="android:fontFamily">@font/plus_jakarta_sans</item>
    </style>
    <style name="Arena.Button" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item><item name="android:textSize">13sp</item><item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/space_grotesk</item><item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item><item name="backgroundTint">@color/blue</item>
        <item name="cornerRadius">12dp</item><item name="android:layout_marginBottom">8dp</item>
    </style>
    <style name="Arena.Secondary" parent="Arena.Button">
        <item name="backgroundTint">@color/surface_high</item><item name="android:textColor">@color/lavender</item>
    </style>
    <style name="Arena.Icon" parent="Arena.Secondary">
        <item name="android:layout_width">48dp</item><item name="android:layout_height">48dp</item>
        <item name="android:padding">12dp</item><item name="android:minWidth">48dp</item>
    </style>
</resources>
