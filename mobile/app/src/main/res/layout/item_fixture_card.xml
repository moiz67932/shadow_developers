<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card_feature" android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"><TextView android:id="@+id/fixture_competition" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="@font/space_grotesk" android:textColor="@color/cyan" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.06" /><TextView android:id="@+id/fixture_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_chip" android:fontFamily="@font/space_grotesk" android:paddingHorizontal="10dp" android:paddingVertical="5dp" android:textColor="@color/cyan" android:textSize="10sp" android:textStyle="bold" /></LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><ImageView android:id="@+id/fixture_home_badge" android:layout_width="54dp" android:layout_height="54dp" android:scaleType="centerInside" /><TextView android:id="@+id/fixture_home" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:fontFamily="@font/space_grotesk" android:gravity="center" android:maxLines="2" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="HOME" android:textColor="@color/text_secondary" android:textSize="10sp" /></LinearLayout>
        <TextView android:id="@+id/fixture_score" android:layout_width="90dp" android:layout_height="54dp" android:background="@drawable/bg_scorebox" android:fontFamily="@font/space_grotesk" android:gravity="center" android:textColor="@color/text_primary" android:textSize="28sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><ImageView android:id="@+id/fixture_away_badge" android:layout_width="54dp" android:layout_height="54dp" android:scaleType="centerInside" /><TextView android:id="@+id/fixture_away" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:fontFamily="@font/space_grotesk" android:gravity="center" android:maxLines="2" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AWAY" android:textColor="@color/text_secondary" android:textSize="10sp" /></LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/fixture_meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_status" android:gravity="center" android:padding="9dp" android:textColor="@color/text_secondary" android:textSize="11sp" />
</LinearLayout>
