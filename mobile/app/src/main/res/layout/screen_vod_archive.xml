<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <com.google.android.material.textfield.TextInputLayout style="@style/Arena.Input" android:hint="Search recordings or athlete IDs">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/vod_search" style="@style/Arena.Edit" android:inputType="text" android:imeOptions="actionSearch" />
    </com.google.android.material.textfield.TextInputLayout>
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
        <com.google.android.material.chip.ChipGroup android:id="@+id/vod_filters" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </HorizontalScrollView>
    <LinearLayout android:id="@+id/vod_featured" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
    <TextView android:id="@+id/vod_count" style="@style/Arena.Label" android:layout_marginTop="16dp" android:text="VOD ARCHIVE &amp; HIGHLIGHTS" android:accessibilityLiveRegion="polite" />
    <LinearLayout android:id="@+id/vod_grid" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
    <TextView android:id="@+id/vod_empty" style="@style/Arena.Body" android:text="Loading recordings…" android:accessibilityLiveRegion="polite" />
    <com.google.android.material.button.MaterialButton android:id="@+id/vod_refresh" style="@style/Arena.Secondary" android:text="Refresh recordings" />
</LinearLayout>
