{
  "name": "nascon-sports-backend",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "worker": "node src/workers/worker.js",
    "test": "jest --runInBand",
    "coverage": "jest --coverage --runInBand",
    "migrate": "node src/database/migrate.js",
    "seed": "node src/database/seed.js"
  },
  "dependencies": {
    "bullmq": "^5.61.0",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.16.0",
    "pg": "^8.13.1",
    "qrcode": "1.5.4",
    "ws": "8.22.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/../tests"
    ],
    "setupFiles": [
      "<rootDir>/../tests/setup.js"
    ],
    "collectCoverageFrom": [
      "src/domain/**/*.js",
      "src/services/day2-db.js",
      "src/services/media-control.js",
      "src/services/privacy-cache.js",
      "src/services/realtime.js",
      "src/utils/day2-sign.js",
      "src/routes/day2.js"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "json-summary",
      "json"
    ]
  }
}
